---
import { SITE } from '../lib/site.js';
import { css } from '../lib/css.js';
const { title, desc = '', path, type = 'website', ld, image } = Astro.props;
const url = SITE + path;
const nav = [['/', 'Home'], ['/news', 'News'], ['/devices', 'Devices'], ['/duo-apps', 'Duo apps'], ['/picks', 'Picks'], ['/week', 'Week'], ['/calendar', 'Calendar'], ['/app', 'Search']];
const cur = path === '/' ? '/' : '/' + path.split('/')[1];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title} · Orchard</title><meta name="description" content={desc}><link rel="canonical" href={url}>
<meta property="og:title" content={title}><meta property="og:description" content={desc}><meta property="og:type" content={type}><meta property="og:url" content={url}><meta property="og:image" content={SITE + (image || '/og.png')}>
<meta name="twitter:card" content="summary_large_image"><meta name="theme-color" content="#F2F0EB" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#08080A" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="Orchard" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap">
<style is:inline set:html={css}></style>
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />}
</head><body>
<header class="top"><div class="w"><a class="logo" href="/">Orchard</a><nav aria-label="Main">{nav.map(([h, l]) => <a href={h} aria-current={h === cur ? 'page' : undefined}>{l}</a>)}</nav></div></header>
<main><div class="w c"><slot /></div></main>
<footer><div class="w">An independent site about Apple, not affiliated with Apple. <a href="/feed.xml">RSS</a> · <a href="/app">Open the full Orchard app</a></div></footer>
</body></html>
