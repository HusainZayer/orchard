---
import data from '../data/state.json';
import { SITE, STATUS, items, apps, trim } from '../lib/site.js';
const today = new Date().toISOString().slice(0, 10);
const news = data.news.filter(n => n.kind === 'news' || n.kind === 'rumor').sort((a, b) => b.date.localeCompare(a.date));
const lead = news[0], rest = news.slice(1, 9);
const LN = { iphone: 'iPhone', ipad: 'iPad', mac: 'Mac', watch: 'Apple Watch', home: 'Home', vision: 'Vision', airpods: 'AirPods', tv: 'Apple TV' };
const launches = Object.entries(data.lines || {}).flatMap(([k, v]) => v.filter(g => g.date > today).map(g => ({ date: g.date, title: g.title, sub: 'In stores · ' + (LN[k] || k) })));
const up = [...launches, ...(data.dates || []).filter(d => d.date > today)].sort((a, b) => a.date.localeCompare(b.date)).slice(0, 5);
const opt = apps.filter(a => a.status === 'optimized').length, soon = apps.filter(a => a.status === 'coming' || a.status === 'announced').length, rep = apps.filter(a => a.status === 'reported').length;
const fresh = apps.filter(a => a.status === 'optimized' && a.featured).sort((a, b) => (b.edited || '').localeCompare(a.edited || '')).slice(0, 6);
const fmt = d => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const desc = 'News, rumors, devices, events and iPhone Duo apps, each with its source. An independent site about Apple, not affiliated with Apple.';
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Orchard', url: SITE, description: desc };
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Orchard · Everything Apple, neatly in rows</title><meta name="description" content={desc}><link rel="canonical" href={SITE + '/'}>
<meta property="og:title" content="Orchard"><meta property="og:description" content={desc}><meta property="og:type" content="website"><meta property="og:url" content={SITE + '/'}><meta property="og:image" content={SITE + '/og.png'}><meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#F2F0EB" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#08080A" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="Orchard" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap">
<script is:inline>if(location.hash.length>1)location.replace('/app'+location.hash)</script>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style is:inline>
:root{--bg:#F2F0EB;--fg:#0E0E10;--mut:#4A4A52;--hard:#0E0E10;--volt:#C6FF3D;--org:#E8600F;--card:#fff}
@media(prefers-color-scheme:dark){:root{--bg:#08080A;--fg:#F2F0EB;--mut:#A8A8B0;--hard:#74747D;--card:#141418}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:17px/1.5 Archivo,system-ui,sans-serif}
a{color:inherit;text-underline-offset:3px}.w{max-width:72rem;margin:0 auto;padding:0 16px}
.top{border-bottom:4px solid var(--fg);padding:14px 0}.top .w{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.logo{font:900 2.2rem/1 Archivo,sans-serif;font-stretch:80%;letter-spacing:-.02em;text-transform:uppercase;text-decoration:none}
nav{display:flex;gap:4px;flex-wrap:wrap;margin-left:auto}nav a{border:2px solid var(--fg);padding:6px 12px;min-height:36px;font-weight:800;font-size:.85rem;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;display:inline-flex;align-items:center}nav a[aria-current]{background:var(--fg);color:var(--volt)}
.k{font:600 12px/1.2 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--mut)}
main{padding:28px 0 56px}.grid{display:grid;gap:24px;grid-template-columns:1fr}@media(min-width:900px){.grid{grid-template-columns:1.6fr 1fr}}
.lead{background:var(--org);color:#0E0E10;border:3px solid var(--fg);box-shadow:6px 6px 0 var(--fg);padding:22px;text-decoration:none;display:block}
.lead h1{font:900 clamp(2rem,6vw,3.6rem)/.98 Archivo,sans-serif;font-stretch:78%;text-transform:uppercase;margin:.3em 0}.lead p{margin:.4em 0;font-size:1.05rem}.lead .k{color:#0E0E10}
h2{font:900 1.5rem/1 Archivo,sans-serif;font-stretch:80%;text-transform:uppercase;border-top:4px solid var(--fg);padding-top:10px;margin:28px 0 8px}
ul.l{list-style:none;margin:0;padding:0}ul.l li{border-bottom:1px solid var(--hard);padding:10px 0}ul.l a{font-weight:700;text-decoration:none}ul.l a:hover{text-decoration:underline}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.stat{border:2px solid var(--fg);padding:10px;background:var(--card)}.stat b{display:block;font:900 2rem/1 Archivo,sans-serif}
.btn{display:inline-flex;align-items:center;min-height:44px;margin-top:10px;padding:8px 16px;background:var(--fg);color:var(--volt);font-weight:800;text-transform:uppercase;letter-spacing:.04em;text-decoration:none}
@media(max-width:600px){.logo{font-size:1.8rem}nav{margin-left:0;width:100%}nav a{padding:4px 8px;min-height:32px;font-size:.72rem;flex:1;justify-content:center}.stats{grid-template-columns:1fr 1fr 1fr}.stat b{font-size:1.5rem}}
footer{border-top:4px solid var(--fg);padding:20px 0 40px;font-size:14px;color:var(--mut)}
</style></head><body>
<header class="top"><div class="w"><a class="logo" href="/">Orchard</a><nav aria-label="Main"><a href="/" aria-current="page">Home</a><a href="/news">News</a><a href="/app#devices">Devices</a><a href="/duo-apps">Duo apps</a><a href="/app">Search</a></nav></div></header>
<main><div class="w"><div class="grid"><div>
{lead && <><p class="k">Top story · {fmt(lead.date)}</p>
<a class="lead" href={`/news/${lead.id}`}><span class="k">{lead.source}</span><h1>{lead.title}</h1><p>{trim(lead.body, 260)}</p></a></>}
<h2>Latest news</h2><ul class="l">{rest.map(n => <li><span class="k">{fmt(n.date)}{n.kind === 'rumor' ? ' · Rumor' : ''}</span><br><a href={`/news/${n.id}`}>{n.title}</a></li>)}</ul>
<a class="btn" href="/news">All news</a>
</div><aside>
{up.length > 0 && <><h2 style="margin-top:0">Coming up</h2><ul class="l">{up.map(d => <li><span class="k">{fmt(d.date)} · {d.sub}</span><br>{d.story ? <a href={`/news/${d.story}`}>{d.title}</a> : d.title}</li>)}</ul></>}
<h2>iPhone Duo apps</h2>
<div class="stats"><div class="stat"><b>{opt}</b><span class="k">Optimized</span></div><div class="stat"><b>{soon}</b><span class="k">Coming</span></div><div class="stat"><b>{rep}</b><span class="k">Developer-reported</span></div></div>
<ul class="l">{fresh.map(a => <li><a href={`/duo-apps/${a.id}`}>{a.name}</a> <span class="k">{a.category}</span></li>)}</ul>
<a class="btn" href="/duo-apps">All {apps.length} Duo apps</a> <a class="btn" href="/app#picks">Our picks</a>
<h2>Tools</h2><ul class="l"><li><a href="/app#devices">Devices and line-ups</a></li><li><a href="/app#calendar">Calendar</a></li><li><a href="/app#week">This week in Apple</a></li><li><a href="/app#compare">Compare</a></li></ul>
</aside></div></div></main>
<footer><div class="w">An independent site about Apple, not affiliated with Apple. <a href="/feed.xml">RSS</a> · <a href="/app#about">About</a></div></footer>
</body></html>
