---
import Base from '../../layouts/Base.astro';
import Pill from '../../components/Pill.astro';
import { apps, STATUS, POST, trim } from '../../lib/site.js';
import { all as picked } from '../../lib/picks.js';
import { icon, letter, fmt } from '../../lib/ui.js';
export function getStaticPaths() { return apps.map(a => ({ params: { id: a.id }, props: { a } })); }
const { a } = Astro.props;
const lab = STATUS[a.status] || 'iPhone Duo app';
const store = a.store || {}, c = a.confirmed;
const ic = icon(a, 256);
const ld = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: a.name, applicationCategory: a.category || 'Application', operatingSystem: 'iOS', ...(a.developer ? { author: { '@type': 'Organization', name: a.developer } } : {}), ...(a.appStore ? { url: a.appStore } : {}), ...(ic ? { image: ic } : {}) };
const pos = (a.postures || []).map(p => POST[p]).filter(Boolean);
const price = a.price || store.p;
const facts = [['Latest version', store.v], ['Updated', store.d && fmt(store.d)], ['Price', price], ['Genre', store.g], ['Added to Orchard', a.added && fmt(a.added)]].filter(([, v]) => v);
const hist = (a.history || []).slice().sort((x, y) => (y.date || '').localeCompare(x.date || '')).slice(0, 8);
---
<Base title={`${a.name} on iPhone Duo`} desc={trim(`${lab}. ${a.body}`)} path={`/duo-apps/${a.id}`} ld={ld} image={picked.includes(a) ? `/og/app/${a.id}.png` : undefined} nav="duo-apps">
<p class="ol-crumb"><a href="/duo-apps">Duo apps</a> / <a href={`/duo-apps/c/${a.category ? a.category.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') : ''}`}>{a.category}</a> / {a.name}</p>
<div class="ol-apphead">
{ic ? <span class="ol-tile lg img"><img src={ic} width="80" height="80" alt="" decoding="async" /></span> : <span class="ol-tile lg" aria-hidden="true">{letter(a)}</span>}
<div><h1 class="ol-title" style="margin:0">{a.name}</h1><p class="ol-k" style="margin-block:4px 12px">{[a.developer, a.category].filter(Boolean).join(' · ')}</p><Pill status={a.status} /></div>
</div>
<div class="ol-cols" style="margin-block-start:40px">
<div>
<h2 class="ol-sh first">What it does on iPhone Duo</h2>
<p class="ol-lead" style="margin-block-start:8px">{a.body}</p>
{pos.length > 0 && <><h2 class="ol-sh">Fold positions</h2><div class="ol-chips">{pos.map(p => <span class="ol-chip">{p}</span>)}</div></>}
{c && <p class="ol-note">Release notes mention iPhone Duo: version {c.v}, {fmt(c.d)}.</p>}
{hist.length > 0 && <><h2 class="ol-sh">History</h2><ul class="ol-hist">{hist.map(h => <li><span class="ol-k">{fmt(h.date)}</span><br>{h.text}{h.link && <div class="ol-src"><a href={h.link} rel="noopener">Source</a></div>}</li>)}</ul></>}
</div>
<aside>
{facts.length > 0 && <><h2 class="ol-sh first">App Store</h2><dl class="ol-facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl></>}
{a.appStore && <a class="ol-btn" href={a.appStore} rel="noopener">View on the App Store</a>}
{a.link && <><h2 class="ol-sh">Source</h2><p class="ol-sub"><a href={a.link} rel="noopener">{(() => { try { return new URL(a.link).hostname.replace(/^www\./, ''); } catch { return 'Source'; } })()}</a></p></>}
</aside>
</div>
</Base>
