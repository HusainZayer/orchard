---
import Base from '../layouts/Base.astro';
import data from '../data/state.json';
import { fmt, srcLine } from '../lib/ui.js';
const rum = data.news.filter(n => n.kind === 'rumor').sort((a, b) => b.date.localeCompare(a.date));
const st = n => n.status === 'confirmed' ? 'came' : n.status === 'pending' ? 'open' : 'wrong';
const c = { came: 0, open: 0, wrong: 0 }; rum.forEach(n => c[st(n)]++);
const first = n => String(n.source || '').split(/[,(]/)[0].trim() || 'Unnamed';
const by = {}; rum.forEach(n => { const k = first(n); by[k] = by[k] || { came: 0, open: 0, wrong: 0 }; by[k][st(n)]++; });
const rows = Object.entries(by).sort((a, b) => (b[1].came + b[1].open + b[1].wrong) - (a[1].came + a[1].open + a[1].wrong) || a[0].localeCompare(b[0])).slice(0, 12);
const pill = { came: ['opt', '✓', 'Came true'], open: ['soon', '…', 'Open'], wrong: ['iss', '×', 'Proved wrong'] };
---
<Base title="Rumor tracker: what was reported, and what Apple did" desc={`${rum.length} Apple rumors with their sources and outcomes: ${c.came} came true, ${c.open} still open, ${c.wrong} proved wrong.`} path="/rumors" nav="rumors">
<p class="ol-k">Rumor tracker · {rum.length} rumors</p>
<h1 class="ol-title">What was reported, and what Apple did</h1>
<p class="ol-lead">Every rumor carries its source and its outcome. Orchard labels a rumor as a rumor until Apple confirms it.</p>
<div class="ol-board" role="img" aria-label={`${c.came} rumors came true, ${c.open} are open, ${c.wrong} proved wrong`}>
{c.came > 0 && <div class="y" style={`flex:${c.came} 1 0`}><span aria-hidden="true">✓</span> {c.came}</div>}
{c.open > 0 && <div class="p" style={`flex:${c.open} 1 0`}><span aria-hidden="true">…</span> {c.open} open</div>}
{c.wrong > 0 && <div class="n" style={`flex:${c.wrong} 1 0`}><span aria-hidden="true">×</span> {c.wrong}</div>}
</div>
<div class="ol-legend"><span style="color:var(--optimized)"><b>✓ {c.came}</b> came true</span><span><b>… {c.open}</b> still open</span>{c.wrong > 0 ? <span style="color:var(--issue)"><b>× {c.wrong}</b> proved wrong</span> : <span>None has been proved wrong.</span>}</div>
<div class="ol-cols">
<div>
<h2 class="ol-sh first">All rumors</h2>
<ul class="ol-list">{rum.map(n => { const p = pill[st(n)]; return <li><span class="ol-date">{fmt(n.date)}</span><div><div class="t"><a class="ol-go" href={`/news/${n.id}`}>{n.title}</a></div><div class="ol-src">{srcLine(n)}</div><div style="margin-block-start:8px"><span class={`ol-badge ${p[0]}`}><span aria-hidden="true">{p[1]}</span>{p[2]}</span>{n.statusNote && <> <span class="ol-sub">{n.statusNote}</span></>}</div></div></li>; })}</ul>
</div>
<aside>
<h2 class="ol-sh first">Scorecard by source</h2>
<div class="ol-scroll" tabindex="0" role="region" aria-label="Table: scrolls sideways if needed"><table class="ol-tbl">
<thead><tr><th scope="col">Source</th><th scope="col">True</th><th scope="col">Open</th>{c.wrong > 0 && <th scope="col">Wrong</th>}</tr></thead>
<tbody>{rows.map(([k, v]) => <tr><td class="p w">{k}</td><td class="n">{v.came}</td><td class="n">{v.open}</td>{c.wrong > 0 && <td class="n">{v.wrong}</td>}</tr>)}</tbody></table></div>
<p class="ol-sub" style="margin-block-start:8px">A rumor is counted under the first source named. Open rumors are not counted as misses.</p>
</aside>
</div>
</Base>
