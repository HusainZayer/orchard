---
import Base from '../../layouts/Base.astro';
import AppRow from '../../components/AppRow.astro';
import { all, top10, cats } from '../../lib/picks.js';
---
<Base title="Our picks: top 100 iPhone Duo apps" desc={`The ${all.length} Duo apps we'd install first, ranked by how well they use the fold, with the reason for each.`} path="/picks" nav="picks">
<p class="ol-k">Our picks · top {all.length}</p>
<h1 class="ol-title">The Duo apps to install first</h1>
<p class="ol-lead">Ranked by how well they use the two screens and the hinge. The ranking comes from our own record of each app (fold positions used, fold-only features, release notes), not from a hands-on review.</p>
<h2 class="ol-sh">By category</h2>
<div class="ol-chips">{cats.map(c => <a class="ol-chip" href={`/picks/${c.slug}`}>{c.name} <span class="ol-count">&nbsp;{c.n}</span></a>)}</div>
<h2 class="ol-sh">Top 10</h2>
<ol style="list-style:none">{top10.map((a, i) => <AppRow a={a} rank={i + 1} />)}</ol>
<h2 class="ol-sh">11 to {all.length}</h2>
<ol style="list-style:none">{all.slice(10).map((a, i) => <AppRow a={a} rank={i + 11} />)}</ol>
</Base>
